---
// StickyOptinBar.astro
// Slim, dismissible bottom bar that offers the book.
//
// It used to repeat the checklist opt-in. In 30 days about 560 readers saw it
// and nobody signed up: it appears after the reader has already seen (and
// usually closed) the welcome-mat popup, which makes the same offer. Those
// readers are the most engaged on the site, so the bar now points them at the
// book instead. Clicks are tracked as book_cta_click with placement
// "sticky_bar" by the listener in Layout.astro.
import { BOOK_URL } from "@/utils/bookCta";
---

<div id="sob" role="region" aria-label="C++ Better Explained book" style="display:none;">
  <div id="sob-inner" data-placement="sticky_bar">
    <p id="sob-copy">
      <strong>C++ Better Explained</strong><span class="sob-more">
        — pointers, memory and OOP in 87 plain-English pages</span
      >
    </p>
    <a id="sob-link" href={BOOK_URL} data-google-vignette="false"
      >Get the book — $27</a
    >
    <button id="sob-close" aria-label="Dismiss">&times;</button>
  </div>
</div>

<style>
  #sob {
    position: fixed;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 9990;
    border-top: 1px solid var(--border);
    background: var(--background);
    box-shadow: 0 -4px 16px rgb(0 0 0 / 12%);
    animation: sob-up 0.35s ease;
  }
  @keyframes sob-up {
    from {
      transform: translateY(100%);
    }
    to {
      transform: translateY(0);
    }
  }
  #sob-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.9rem;
    align-items: center;
    justify-content: center;
    max-width: 60rem;
    margin: 0 auto;
    padding: 0.7rem 2.5rem 0.7rem 1rem;
  }
  #sob-copy {
    margin: 0;
    font-size: 0.9rem;
  }
  #sob-link {
    padding: 0.45rem 0.9rem;
    border-radius: 0.5rem;
    background: var(--accent);
    color: #fff;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  #sob-link:hover {
    opacity: 0.9;
  }
  #sob-close {
    position: absolute;
    top: 0.35rem;
    right: 0.6rem;
    border: 0;
    background: none;
    color: var(--foreground);
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
    opacity: 0.5;
  }
  #sob-close:hover {
    opacity: 1;
  }
  /* When AdSense shows its anchor ad along the bottom edge, the bar moves to
     the top edge so the ad doesn't cover it (see place() below). */
  #sob.sob-top {
    top: 0;
    bottom: auto;
    border-top: 0;
    border-bottom: 1px solid var(--border);
    box-shadow: 0 4px 16px rgb(0 0 0 / 12%);
    animation-name: sob-down;
  }
  @keyframes sob-down {
    from {
      transform: translateY(-100%);
    }
    to {
      transform: translateY(0);
    }
  }
  @media (width <= 640px) {
    .sob-more {
      display: none;
    }
  }
</style>

<script is:inline>
  (function () {
    var KEY = "sob_dismissed";
    var SCROLL_TRIGGER = 0.5;
    var DELAY_MS = 60000;
    var COOLDOWN_MS = 3 * 24 * 60 * 60 * 1000;

    function dismissed() {
      try {
        var mine = localStorage.getItem(KEY);
        return !!mine && Date.now() - parseInt(mine, 10) < COOLDOWN_MS;
      } catch (e) {
        return false;
      }
    }

    // Don't sit underneath the welcome mat while it is open.
    function popupOpen() {
      var wm = document.getElementById("welcome-mat");
      return !!wm && wm.style.display !== "none";
    }

    // AdSense's anchor ad is fixed to the top or bottom edge with the highest
    // z-index there is, so it covers anything else on that edge. Returns
    // "bottom", "top" or "" for where an anchor ad is showing right now.
    function anchorAdEdge() {
      var ads = document.querySelectorAll("ins.adsbygoogle[data-anchor-status]");
      for (var i = 0; i < ads.length; i++) {
        var r = ads[i].getBoundingClientRect();
        if (r.height < 20 || r.width < 100) continue;
        if (r.bottom >= window.innerHeight - 2) return "bottom";
        if (r.top <= 2) return "top";
      }
      return "";
    }

    function init() {
      var bar = document.getElementById("sob");
      if (!bar || bar.dataset.bound) return;
      bar.dataset.bound = "1";
      if (dismissed()) return;

      var shown = false;
      var due = false;
      var placer = null;

      function show() {
        if (shown || dismissed()) return;
        if (popupOpen()) return; // tryShow runs again once it's closed
        shown = true;
        place();
        bar.style.display = "block";
        cleanup();
        // Anchor ads load late and readers can collapse them, so keep the
        // bar on the free edge for as long as it is showing.
        placer = setInterval(place, 1000);
        try {
          if (typeof window.gtag === "function") {
            window.gtag("event", "book_bar_view", { placement: "sticky_bar" });
          }
        } catch (e) {}
      }

      // Sit on the bottom edge unless an anchor ad is there.
      function place() {
        bar.classList.toggle("sob-top", anchorAdEdge() === "bottom");
      }

      function tryShow() {
        if (due) show();
      }

      function onScroll() {
        var max = document.documentElement.scrollHeight - window.innerHeight;
        if (max > 0 && window.scrollY / max >= SCROLL_TRIGGER) due = true;
        tryShow();
      }

      // If the popup was open when the bar came due, show the bar as soon as
      // the reader closes it.
      function onClick() {
        setTimeout(tryShow, 400);
      }

      var timer = setTimeout(function () {
        due = true;
        tryShow();
      }, DELAY_MS);

      function cleanup() {
        window.removeEventListener("scroll", onScroll);
        document.removeEventListener("click", onClick);
        clearTimeout(timer);
      }

      window.addEventListener("scroll", onScroll, { passive: true });
      document.addEventListener("click", onClick);
      // Leaving this page: stop this page's timer and listeners.
      document.addEventListener(
        "astro:before-swap",
        function () {
          cleanup();
          clearInterval(placer);
        },
        { once: true }
      );

      document
        .getElementById("sob-close")
        .addEventListener("click", function () {
          bar.style.display = "none";
          clearInterval(placer);
          try {
            localStorage.setItem(KEY, String(Date.now()));
          } catch (e) {}
        });
    }

    init();
    document.addEventListener("astro:page-load", init);
  })();
</script>
