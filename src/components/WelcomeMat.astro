---
// WelcomeMat.astro
// Full-screen welcome mat -> calls Sender.net API directly -> redirects to tripwire.
// Shows only once per browser using localStorage.
---

<div id="welcome-mat" aria-modal="true" role="dialog" aria-labelledby="wm-heading" style="display:none;">
  <div id="wm-backdrop"></div>
  <div id="wm-card">
    <button id="wm-close" aria-label="Close">&times;</button>
    <div id="wm-icon">📋</div>
    <h2 id="wm-heading">Download Free: The 10 Mistakes Every C++ Beginner Makes (And How to Avoid Them)</h2>
    <p id="wm-subtext">
      A free 1-page checklist that shows you the exact traps that slow down every C++ beginner — so you can avoid them from day one.
    </p>
    <form id="wm-form">
      <div id="wm-input-row">
        <input
          type="email"
          name="email"
          id="wm-email"
          placeholder="you@example.com"
          required
          autocomplete="email"
        />
        <button type="submit" id="wm-submit">Send it to me</button>
      </div>
      <p id="wm-privacy">🔒 No spam. Unsubscribe anytime.</p>
    </form>
    <div id="wm-success" style="display:none;">
      <div id="wm-success-icon">🎉</div>
      <p id="wm-success-msg">You're in! Redirecting you to a special offer...</p>
    </div>
    <button id="wm-skip">No thanks, I'll just browse</button>
  </div>
</div>

<style>
  #welcome-mat {
    position: fixed;
    inset: 0;
    z-index: 9999;
    align-items: center;
    justify-content: center;
    animation: wm-fadein 0.4s ease;
  }
  @keyframes wm-fadein {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  @keyframes wm-slideup {
    from { transform: translateY(40px); opacity: 0; }
    to   { transform: translateY(0); opacity: 1; }
  }
  #wm-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(4px);
  }
  #wm-card {
    position: relative;
    z-index: 1;
    background: var(--color-fill, #fff);
    color: var(--color-text-base, #111);
    border: 1px solid var(--color-border, #e5e7eb);
    border-radius: 1.25rem;
    padding: 2.5rem 2rem;
    max-width: 480px;
    width: 90%;
    text-align: center;
    box-shadow: 0 25px 60px rgba(0,0,0,0.25);
    animation: wm-slideup 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }
  #wm-close {
    position: absolute;
    top: 0.75rem;
    right: 1rem;
    background: none;
    border: none;
    font-size: 1.75rem;
    line-height: 1;
    cursor: pointer;
    color: var(--color-text-base, #666);
    opacity: 0.6;
    transition: opacity 0.2s;
  }
  #wm-close:hover { opacity: 1; }
  #wm-icon { font-size: 3rem; margin-bottom: 0.75rem; }
  #wm-heading {
    font-size: 1.6rem;
    font-weight: 700;
    margin: 0 0 0.75rem;
    line-height: 1.2;
    color: var(--color-text-base, #111);
  }
  #wm-subtext {
    font-size: 0.95rem;
    line-height: 1.6;
    opacity: 0.8;
    margin: 0 0 1.5rem;
  }
  #wm-input-row { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  #wm-email {
    flex: 1;
    min-width: 0;
    padding: 0.65rem 1rem;
    border-radius: 0.5rem;
    border: 1px solid var(--color-border, #d1d5db);
    background: var(--color-card, #f9fafb);
    color: var(--color-text-base, #111);
    font-size: 0.95rem;
    outline: none;
    transition: border-color 0.2s;
  }
  #wm-email:focus { border-color: var(--color-accent, #6366f1); }
  #wm-submit {
    padding: 0.65rem 1.4rem;
    border-radius: 0.5rem;
    border: none;
    background: var(--color-accent, #6366f1);
    color: #fff;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 0.2s;
    white-space: nowrap;
  }
  #wm-submit:hover { opacity: 0.88; }
  #wm-submit:disabled { opacity: 0.55; cursor: not-allowed; }
  #wm-privacy { font-size: 0.75rem; opacity: 0.55; margin: 0.6rem 0 0; }
  #wm-skip {
    margin-top: 1.2rem;
    background: none;
    border: none;
    font-size: 0.82rem;
    opacity: 0.5;
    cursor: pointer;
    text-decoration: underline;
    color: var(--color-text-base, #111);
    transition: opacity 0.2s;
  }
  #wm-skip:hover { opacity: 0.8; }
  #wm-success-icon { font-size: 2.5rem; margin-bottom: 0.5rem; }
  #wm-success-msg { font-size: 1rem; font-weight: 600; }
  @media (max-width: 360px) {
    #wm-input-row { flex-direction: column; }
    #wm-submit { width: 100%; }
  }
</style>

<script is:inline>
(function () {
  var STORAGE_KEY      = "wm_dismissed";
  var TRIPWIRE_URL     = "https://start.cppbetterexplained.com/tw-sales-page";
  var SCROLL_TRIGGER   = 0.35;   // show after 35% scroll depth (engaged reader)
  var FALLBACK_MS      = 45000;  // fallback for visitors who never scroll

  function isDismissed() {
    try {
      var ts = localStorage.getItem(STORAGE_KEY);
      if (!ts) return false;
      // Show again after 3 days — someone who closed it once might subscribe later
      return (Date.now() - parseInt(ts, 10)) < 3 * 24 * 60 * 60 * 1000;
    } catch(e) { return false; }
  }
  function markDismissed() {
    try { localStorage.setItem(STORAGE_KEY, String(Date.now())); } catch(e) {}
  }
  function hide() {
    var el = document.getElementById("welcome-mat");
    if (!el) return;
    el.style.opacity = "0";
    el.style.transition = "opacity 0.3s";
    setTimeout(function () { el.style.display = "none"; }, 320);
  }
  function dismiss() { markDismissed(); hide(); }

  function init() {
    if (isDismissed()) return;
    var mat = document.getElementById("welcome-mat");
    if (!mat) return;
    if (mat.dataset.wmInit) return;
    mat.dataset.wmInit = "1";

    var form    = document.getElementById("wm-form");
    var success = document.getElementById("wm-success");
    var submit  = document.getElementById("wm-submit");

    // Show once on: 35% scroll depth, exit intent, or 45s dwell - whichever first.
    var shown = false;
    function show() {
      if (shown || isDismissed()) return;
      shown = true;
      mat.style.display = "flex";
      cleanup();
    }
    function onScroll() {
      var max = document.documentElement.scrollHeight - window.innerHeight;
      if (max <= 0) return;
      if (window.scrollY / max >= SCROLL_TRIGGER) show();
    }
    function onExitIntent(e) {
      // Mouse left the viewport toward the top (heading for the tab bar)
      if (!e.relatedTarget && e.clientY <= 0) show();
    }
    var fallbackTimer = setTimeout(show, FALLBACK_MS);
    function cleanup() {
      window.removeEventListener("scroll", onScroll);
      document.removeEventListener("mouseout", onExitIntent);
      clearTimeout(fallbackTimer);
    }
    window.addEventListener("scroll", onScroll, { passive: true });
    document.addEventListener("mouseout", onExitIntent);

    document.getElementById("wm-close").addEventListener("click", dismiss);
    document.getElementById("wm-skip").addEventListener("click", dismiss);
    document.getElementById("wm-backdrop").addEventListener("click", dismiss);
    document.addEventListener("keydown", function onKey(e) {
      if (e.key === "Escape") { dismiss(); document.removeEventListener("keydown", onKey); }
    });

    form.addEventListener("submit", function (e) {
      e.preventDefault();
      var email = document.getElementById("wm-email").value.trim();
      submit.disabled = true;
      submit.textContent = "Subscribing\u2026";

      fetch("/api/subscribe", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email: email })
      })
      .then(function (res) {
        if (!res.ok) {
          console.error("Subscribe error:", res.status, res.statusText);
          submit.disabled = false;
          submit.textContent = "Try again";
          return;
        }
        markDismissed();
        form.style.display = "none";
        success.style.display = "block";
        setTimeout(function () {
          window.location.href = TRIPWIRE_URL;
        }, 1200);
      })
      .catch(function (err) {
        console.error("Subscribe network error:", err);
        submit.disabled = false;
        submit.textContent = "Try again";
      });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
  document.addEventListener("astro:page-load", init);
})();
</script>