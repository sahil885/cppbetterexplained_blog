---
import { ClientRouter } from "astro:transitions";
import { SITE } from "@/config";
import WelcomeMat from "@/components/WelcomeMat.astro";
import StickyOptinBar from "@/components/StickyOptinBar.astro";
import {
  OPTIN_OFFER_URL,
  OPTIN_REDIRECT_DELAY_MS,
  OPTIN_SUCCESS_MESSAGE,
  OPTIN_SKIP_LABEL,
} from "@/utils/optinSuccess";
import "@/styles/global.css";

type Props = {
  title?: string;
  author?: string;
  profile?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
  scrollSmooth?: boolean;
  faqSchema?: { question: string; answer: string }[];
  noindex?: boolean;
  hideAds?: boolean;
};

const {
  title = SITE.title,
  author = SITE.author,
  profile = SITE.profile,
  description = SITE.desc,
  ogImage = SITE.ogImage ? `/${SITE.ogImage}` : "/og.png",
  canonicalURL = new URL(Astro.url.pathname, Astro.url),
  pubDatetime,
  modDatetime,
  scrollSmooth = false,
  faqSchema,
  noindex = false,
  hideAds = false,
} = Astro.props;

const socialImageURL = new URL(ogImage, Astro.url);

// Public profiles for E-E-A-T (linked via sameAs in structured data)
const AUTHOR_SAME_AS = ["https://www.youtube.com/@cbetterexplained"];

const isArticle = !!pubDatetime;
const structuredData = isArticle
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: `${title}`,
      description: `${description}`,
      url: `${canonicalURL}`,
      image: `${socialImageURL}`,
      datePublished: pubDatetime!.toISOString(),
      ...(modDatetime && { dateModified: modDatetime.toISOString() }),
      author: [
        {
          "@type": "Person",
          name: `${author}`,
          ...(profile && { url: profile }),
          sameAs: AUTHOR_SAME_AS,
        },
      ],
      publisher: {
        "@type": "Organization",
        name: SITE.title,
        url: SITE.website,
        sameAs: AUTHOR_SAME_AS,
        logo: {
          "@type": "ImageObject",
          url: `${new URL("/favicon.svg", Astro.url)}`,
        },
      },
      mainEntityOfPage: {
        "@type": "WebPage",
        "@id": `${canonicalURL}`,
      },
    }
  : {
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: `${title}`,
      url: `${canonicalURL}`,
      description: `${description}`,
      publisher: {
        "@type": "Organization",
        name: SITE.title,
        url: SITE.website,
        sameAs: AUTHOR_SAME_AS,
      },
    }
---

<!doctype html>
<html
  dir={SITE.dir}
  lang={`${SITE.lang ?? "en"}`}
  class={`${scrollSmooth && "scroll-smooth"}`}
>
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-PGXR22EZL6"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-PGXR22EZL6');

      // Send a GA4 event. If `next` is given (a redirect or navigation), run it
      // once GA confirms the hit, or after 1 second at most. `minDelayMs` keeps a
      // success message on screen for at least that long before `next` runs.
      window.cbeTrack = function (name, params, next, minDelayMs) {
        const payload = Object.assign({}, params, { transport_type: "beacon" });
        if (typeof next !== "function") {
          gtag("event", name, payload);
          return;
        }
        let sent = false;
        let waited = !minDelayMs;
        let done = false;
        const finish = () => {
          if (done || !sent || !waited) return;
          done = true;
          next();
        };
        const markSent = () => {
          sent = true;
          finish();
        };
        payload.event_callback = markSent;
        payload.event_timeout = 1000;
        setTimeout(markSent, 1000);
        if (minDelayMs) {
          setTimeout(() => {
            waited = true;
            finish();
          }, minDelayMs);
        }
        gtag("event", name, payload);
      };
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />


    <!-- General Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={isArticle ? "article" : "website"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:site_name" content={SITE.title} />

    <!-- Article Published/Modified time -->
    {
      pubDatetime && (
        <meta
          property="article:published_time"
          content={pubDatetime.toISOString()}
        />
      )
    }
    {
      modDatetime && (
        <meta
          property="article:modified_time"
          content={modDatetime.toISOString()}
        />
      )
    }

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />

    <!-- Google JSON-LD Structured data -->
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />

    <!-- FAQPage JSON-LD (injected when post includes faqSchema) -->
    {
      faqSchema && faqSchema.length > 0 && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "FAQPage",
            mainEntity: faqSchema.map(({ question, answer }) => ({
              "@type": "Question",
              name: question,
              acceptedAnswer: {
                "@type": "Answer",
                text: answer,
              },
            })),
          })}
        />
      )
    }

    <!-- BreadcrumbList JSON-LD (injected on all blog posts) -->
    {
      isArticle && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "BreadcrumbList",
            itemListElement: [
              {
                "@type": "ListItem",
                position: 1,
                name: "Home",
                item: SITE.website,
              },
              {
                "@type": "ListItem",
                position: 2,
                name: "Posts",
                item: `${SITE.website}posts/`,
              },
              {
                "@type": "ListItem",
                position: 3,
                name: title.replace(` | ${SITE.title}`, ""),
                item: `${canonicalURL}`,
              },
            ],
          })}
        />
      )
    }

    <!-- Enable RSS feed auto-discovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.title}
      href={new URL("rss.xml", Astro.site)}
    />

    <meta name="theme-color" content="" />

    {
      import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION && (
        <meta
          name="google-site-verification"
          content={import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION}
        />
      )
    }

    <ClientRouter />

    <!-- Minimal inline script to prevent FOUC -->
    <script is:inline>
      (function () {
        const initialColorScheme = "";
        const currentTheme = localStorage.getItem("theme");

        function getPreferTheme() {
          if (currentTheme) return currentTheme;
          if (initialColorScheme) return initialColorScheme;
          return window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
        }

        const themeValue = getPreferTheme();
        document.firstElementChild?.setAttribute("data-theme", themeValue);

        window.theme = {
          themeValue: themeValue,
          getTheme: () => window.theme.themeValue,
          setTheme: val => {
            window.theme.themeValue = val;
          },
        };
      })();
    </script>

    <!-- Google AdSense (Auto Ads) — suppressed on high-intent funnel pages via hideAds -->
    {
      !hideAds && (
        <script
          async
          src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2676272684727826"
          crossorigin="anonymous"
        ></script>
      )
    }

    <!-- Shared after-sign-up step for every opt-in form -->
    <script
      is:inline
      define:vars={{
        OFFER_URL: OPTIN_OFFER_URL,
        DELAY_MS: OPTIN_REDIRECT_DELAY_MS,
        MESSAGE: OPTIN_SUCCESS_MESSAGE,
        SKIP_LABEL: OPTIN_SKIP_LABEL,
      }}
    >
      // After a successful sign-up, every opt-in form calls this so it behaves
      // like the welcome-mat popup: send optin_submit with the form's own
      // location (the GA "Opt in location"), keep the success message up for
      // DELAY_MS, then go to the offer. Values: src/utils/optinSuccess.ts.
      //   location  required, e.g. "post_bottom"
      //   message   optional element holding the form's success text. It gets
      //             the popup's message plus a "No thanks, I'll just browse"
      //             link; the link cancels the redirect and puts the form's
      //             own "Check your inbox" text back.
      //   delayMs   optional, defaults to DELAY_MS
      // Returns a function that cancels the redirect.
      window.cbeOptinSuccess = function (opts) {
        const o = opts || {};
        const delay = o.delayMs || DELAY_MS;
        const msg = o.message;
        let cancelled = false;
        if (msg) {
          const confirmation = msg.textContent.trim();
          msg.textContent = "\uD83C\uDF89 " + MESSAGE;
          const skip = document.createElement("button");
          skip.type = "button";
          skip.className = "optin-skip";
          skip.textContent = SKIP_LABEL;
          skip.addEventListener("click", () => {
            cancelled = true;
            msg.textContent = confirmation;
            skip.remove();
          });
          msg.after(skip);
        }
        const goToOffer = () => {
          if (!cancelled) window.location.href = OFFER_URL;
        };
        const params = { location: o.location || "other" };
        if (typeof window.cbeTrack === "function") {
          window.cbeTrack("optin_submit", params, goToOffer, delay);
        } else {
          setTimeout(goToOffer, delay);
        }
        return () => {
          cancelled = true;
        };
      };
    </script>
  </head>
  <body>
    <slot />

    <!-- Welcome Mat email capture -->
    <WelcomeMat />
    <StickyOptinBar />
    <!-- GA4: one site-wide listener for every link to the sales page.
         Opt-in forms send their own optin_submit (with a location) after a
         successful signup, so there is no global submit listener. -->
    <script is:inline>
      (() => {
        if (window.cbeClickTrackingBound) return;
        window.cbeClickTrackingBound = true;

        // placement: an explicit data-placement wins; older Markdown patterns are
        // recognised by their markup; anything else is "other".
        const placementFor = link => {
          const tagged = link.closest("[data-placement]");
          if (tagged) return tagged.getAttribute("data-placement");
          if (link.closest(".featured-book")) return "book_box";
          if (link.closest(".inline-cta")) return "early_link";
          if (link.closest("table")) return "comparison_table";
          const article = link.closest("#article");
          if (article) {
            let block = link;
            while (block.parentElement && block.parentElement !== article) {
              block = block.parentElement;
            }
            for (let el = block; el; el = el.previousElementSibling) {
              if (el.tagName === "H2") {
                return /^take your c\+\+ further/i.test(el.textContent.trim())
                  ? "end_cta"
                  : "other";
              }
            }
          }
          return "other";
        };

        const textFor = link => {
          const img = link.querySelector("img");
          const text =
            link.textContent.trim() ||
            link.getAttribute("aria-label") ||
            (img && img.getAttribute("alt")) ||
            "";
          return text.replace(/\s+/g, " ").trim().slice(0, 100);
        };

        const track = (e, allowHold) => {
          const link =
            e.target instanceof Element
              ? e.target.closest('a[href*="start.cppbetterexplained.com"]')
              : null;
          if (!link || typeof window.cbeTrack !== "function") return;
          const params = {
            placement: placementFor(link),
            link_text: textFor(link),
            link_url: link.href,
            page_path: location.pathname,
          };
          const sameTab = !link.target || link.target === "_self";
          const plainClick =
            e.button === 0 && !e.metaKey && !e.ctrlKey && !e.shiftKey && !e.altKey;
          if (allowHold && sameTab && plainClick && !e.defaultPrevented) {
            // Hold the navigation until GA has the event (1 second at most).
            e.preventDefault();
            window.cbeTrack("book_cta_click", params, () => {
              window.location.href = link.href;
            });
          } else {
            window.cbeTrack("book_cta_click", params);
          }
        };

        // AdSense vignettes (full-screen ads) can fire when a link is clicked.
        // Keep them off links to the sales page (Google's documented opt-out).
        const optOutOfVignettes = () => {
          document
            .querySelectorAll(
              'a[href*="start.cppbetterexplained.com"]:not([data-google-vignette])'
            )
            .forEach(link => link.setAttribute("data-google-vignette", "false"));
        };
        optOutOfVignettes();
        document.addEventListener("astro:page-load", optOutOfVignettes);

        document.addEventListener("click", e => track(e, true));
        // Middle-click opens a new tab without firing "click".
        document.addEventListener("auxclick", e => {
          if (e.button === 1) track(e, false);
        });
      })();
    </script>

  </body>
</html>