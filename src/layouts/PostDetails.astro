---
import { render, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Tag from "@/components/Tag.astro";
import Datetime from "@/components/Datetime.astro";
import EditPost from "@/components/EditPost.astro";
import ShareLinks from "@/components/ShareLinks.astro";
import BackButton from "@/components/BackButton.astro";
import BackToTopButton from "@/components/BackToTopButton.astro";
import AuthorBio from "@/components/AuthorBio.astro";
import Card from "@/components/Card.astro";
import { getPath } from "@/utils/getPath";
import { slugifyStr } from "@/utils/slugify";
import IconChevronLeft from "@/assets/icons/IconChevronLeft.svg";
import IconChevronRight from "@/assets/icons/IconChevronRight.svg";
import { SITE } from "@/config";

type Props = {
  post: CollectionEntry<"blog">;
  posts: CollectionEntry<"blog">[];
};

const { post, posts } = Astro.props;

const {
  title,
  author,
  description,
  ogImage: initOgImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  timezone,
  tags,
  hideEditPost,
  faqSchema,
  hideAds,
  hidePostOptin,
  hideMidOptin,
} = post.data;

const { Content } = await render(post);

// Posts that offer the full source code as a content upgrade (instead of the checklist)
const SOURCE_CODE_SLUGS = [
  "blackjack-cpp-using-classes",
  "lottery-program-cpp",
  "traffic-light-project",
];
const sourceSlug = SOURCE_CODE_SLUGS.find(slug => post.id.includes(slug));
const isProject = Boolean(sourceSlug);
const optin = isProject
  ? {
      icon: "\u{1F4BB}",
      heading: "Get the Complete Source Code",
      subtext:
        "Enter your email and get the full, ready-to-compile source code for this project as an instant download \u2014 plus my free C++ beginner checklist.",
      button: "Send me the code \u2192",
      list: "source-code",
      download: `/downloads/${sourceSlug}.zip`,
      success: "\u{1F389} Your download is starting\u2026",
    }
  : {
      icon: "\u{1F4CB}",
      heading: "Free Download: The 10 Mistakes Every C++ Beginner Makes",
      subtext:
        "A free 1-page checklist that shows the exact traps that slow down every C++ beginner \u2014 so you can avoid them from day one.",
      button: "Send it to me \u2192",
      list: "checklist",
      download: null,
      success: "\u{1F389} Check your inbox \u2014 it's on its way!",
    };

let ogImageUrl: string | undefined;

// Determine OG image source
if (typeof initOgImage === "string") {
  ogImageUrl = initOgImage; // Remote OG image (absolute URL)
} else if (initOgImage?.src) {
  ogImageUrl = initOgImage.src; // Local asset
}

// Use dynamic OG image if enabled and no remote|local ogImage
if (!ogImageUrl && SITE.dynamicOgImage) {
  ogImageUrl = `${getPath(post.id, post.filePath)}/index.png`;
}

// Resolve OG image URL (or fallback to SITE.ogImage / default `og.png`)
const ogImage = ogImageUrl
  ? new URL(ogImageUrl, Astro.url.origin).href
  : undefined;

const layoutProps = {
  title: `${title} | CppBE`,
  author,
  description,
  pubDatetime,
  modDatetime,
  canonicalURL,
  ogImage,
  scrollSmooth: true,
  faqSchema,
  hideAds,
};

/* ========== Related Posts (internal linking) ========== */

// Pick up to 4 posts that share the most tags with this one and are NOT
// already linked in the article body — so every post also links laterally
// to newer/stranded posts instead of only its hand-picked related articles.
const currentTagSet = new Set(tags.map((t: string) => slugifyStr(t)));
const postBody = post.body ?? "";
const relatedPosts = posts
  .filter(p => p.id !== post.id)
  .map(p => ({
    entry: p,
    sharedTags: (p.data.tags ?? []).filter((t: string) =>
      currentTagSet.has(slugifyStr(t))
    ).length,
    alreadyLinked: postBody.includes(getPath(p.id, p.filePath)),
  }))
  .filter(({ sharedTags, alreadyLinked }) => sharedTags > 0 && !alreadyLinked)
  .sort((a, b) => b.sharedTags - a.sharedTags)
  .slice(0, 4)
  .map(({ entry }) => entry);

/* ========== Beginner series navigation ========== */

// The core beginner learning path, in teaching order. Posts inside this
// list get "Part N of M" navigation so readers move to the next lesson
// instead of leaving after one page.
const SERIES: string[] = [
  "cpp-hello-world-explained",
  "cpp-comments",
  "cpp-variables-data-types",
  "cpp-cin-user-input",
  "cpp-conditionals-tutorial",
  "cpp-loops-tutorial",
  "cpp-nested-loops",
  "cpp-break-continue",
  "cpp-functions-tutorial",
  "cpp-recursion-tutorial",
  "cpp-arrays-tutorial",
  "cpp-array-size",
  "cpp-pass-array-to-function",
  "cpp-2d-array",
  "cpp-string-handling",
  "cpp-vector-tutorial",
  "pointers-in-cpp",
  "cpp-reference-vs-pointer",
  "cpp-stack-vs-heap",
  "memory-management-cpp",
  "cpp-structs-explained",
  "cpp-classes-and-objects",
  "oop-in-cpp",
  "cpp-inheritance",
  "virtual-functions-polymorphism-cpp",
  "stl-containers-cpp",
];

const currentSlug = post.id.split("/").pop()?.replace(/\.md$/, "") ?? post.id;
const seriesIndex = SERIES.indexOf(currentSlug);
const inSeries = seriesIndex !== -1;

const slugToPost = new Map(
  posts.map(p => [p.id.split("/").pop()?.replace(/\.md$/, "") ?? p.id, p])
);
const seriesPrev = inSeries && seriesIndex > 0 ? slugToPost.get(SERIES[seriesIndex - 1]) : undefined;
const seriesNext =
  inSeries && seriesIndex < SERIES.length - 1 ? slugToPost.get(SERIES[seriesIndex + 1]) : undefined;

// The single best "read next" suggestion for the in-article prompt:
// the next lesson if this post is part of the series, otherwise the
// closest tag-related post.
const readNext = seriesNext ?? relatedPosts[0];
const readNextLabel = seriesNext ? "Next lesson" : "Read next";

/* ========== VideoObject schema for embedded YouTube videos ========== */

// Emit VideoObject JSON-LD for every YouTube embed in the article so posts
// become eligible for video rich results in Google Search.
const iframeTags = postBody.match(/<iframe[^>]*youtube\.com\/embed\/[^>]*>/g) ?? [];
const videoSchemas = iframeTags
  .map(tag => {
    const id = (tag.match(/embed\/([\w-]+)/) || [])[1];
    if (!id) return null;
    const vTitle = (tag.match(/title="([^"]*)"/) || [])[1];
    return {
      "@context": "https://schema.org",
      "@type": "VideoObject",
      name: vTitle || `${title} — Video Walkthrough`,
      description: vTitle
        ? `${vTitle} — video walkthrough from the C++ Better Explained YouTube channel.`
        : `Video walkthrough for: ${title}`,
      thumbnailUrl: [`https://i.ytimg.com/vi/${id}/hqdefault.jpg`],
      uploadDate: pubDatetime.toISOString(),
      embedUrl: `https://www.youtube.com/embed/${id}`,
      contentUrl: `https://www.youtube.com/watch?v=${id}`,
      publisher: {
        "@type": "Organization",
        name: SITE.title,
        url: SITE.website,
      },
    };
  })
  .filter(Boolean);

/* ========== Prev/Next Posts ========== */

const allPosts = posts.map(({ data: { title }, id, filePath }) => ({
  id,
  title,
  filePath,
}));

const currentPostIndex = allPosts.findIndex(a => a.id === post.id);

const prevPost = currentPostIndex !== 0 ? allPosts[currentPostIndex - 1] : null;
const nextPost =
  currentPostIndex !== allPosts.length ? allPosts[currentPostIndex + 1] : null;
---

<Layout {...layoutProps}>
  <Header />
  <BackButton />
  <main
    id="main-content"
    class:list={["app-layout pb-12", { "mt-8": !SITE.showBackButton }]}
    data-pagefind-body
  >
    <!-- Breadcrumb navigation -->
    <nav aria-label="Breadcrumb" class="mb-4 text-sm text-foreground/60">
      <ol class="flex flex-wrap items-center gap-1">
        <li>
          <a href="/" class="hover:text-accent hover:underline">Home</a>
        </li>
        <li aria-hidden="true" class="select-none">/</li>
        <li>
          <a href="/posts/" class="hover:text-accent hover:underline">Posts</a>
        </li>
        <li aria-hidden="true" class="select-none">/</li>
        <li class="truncate max-w-[200px] sm:max-w-xs" aria-current="page">
          {title}
        </li>
      </ol>
    </nav>

    <div
      transition:name={slugifyStr(title.replaceAll(".", "-"))}
      class="inline-block text-2xl font-bold text-accent sm:text-3xl"
    >
      {title}
    </div>
    <div class="my-2 flex items-center gap-2">
      <Datetime {pubDatetime} {modDatetime} {timezone} size="lg" />
      <span
        aria-hidden="true"
        class:list={[
          "max-sm:hidden",
          { hidden: !SITE.editPost.enabled || hideEditPost },
        ]}>|</span
      >
      <EditPost {hideEditPost} {post} class="max-sm:hidden" />
    </div>
    {
      inSeries && (
        <nav
          class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-1 rounded-lg border border-border bg-card px-4 py-3 text-sm"
          aria-label="Series navigation"
        >
          <span class="font-semibold text-accent">
            C++ Beginner Series — Part {seriesIndex + 1} of {SERIES.length}
          </span>
          {seriesPrev && (
            <a
              href={getPath(seriesPrev.id, seriesPrev.filePath)}
              class="opacity-80 hover:text-accent hover:underline"
            >
              ← Previous: {seriesPrev.data.title}
            </a>
          )}
          {seriesNext && (
            <a
              href={getPath(seriesNext.id, seriesNext.filePath)}
              class="opacity-80 hover:text-accent hover:underline"
            >
              Next: {seriesNext.data.title} →
            </a>
          )}
        </nav>
      )
    }

    <article
      id="article"
      class="app-prose mt-8 w-full max-w-app prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)"
    >
      <Content />
    </article>

    <!-- ===== Email Opt-in (bottom of post) ===== -->
    {
      !hidePostOptin && (
    <div class="my-10 rounded-2xl border border-accent/30 bg-accent/5 px-6 py-8 text-center">
      <div class="text-3xl mb-3">{optin.icon}</div>
      <h3 class="text-xl font-bold text-accent mb-2">{optin.heading}</h3>
      <p class="text-sm opacity-75 mb-5 max-w-md mx-auto">
        {optin.subtext}
      </p>
      <form class="post-optin-form flex flex-col sm:flex-row gap-3 justify-center max-w-md mx-auto" data-list={optin.list} data-download={optin.download}>
        <input
          type="email"
          name="email"
          placeholder="your@email.com"
          required
          autocomplete="email"
          class="flex-1 min-w-0 px-4 py-2.5 rounded-lg border border-border bg-card text-foreground text-sm outline-none focus:border-accent transition-colors"
        />
        <button
          type="submit"
          class="px-5 py-2.5 rounded-lg bg-accent text-white font-semibold text-sm cursor-pointer whitespace-nowrap hover:opacity-90 transition-opacity disabled:opacity-50"
        >
          {optin.button}
        </button>
      </form>
      <p class="text-xs opacity-40 mt-3">🔒 No spam. Unsubscribe anytime.</p>
      <div class="post-optin-success hidden mt-4">
        <p class="text-base font-semibold text-accent">{optin.success}</p>
      </div>
    </div>
      )
    }
    <!-- ===== End Email Opt-in ===== -->

    <!-- In-article "read next" prompt: inserted before the first H2 by script below -->
    {
      readNext && (
        <template id="read-next-template">
          <div class="read-next not-prose my-6 rounded-lg border-l-4 border-accent bg-accent/5 px-4 py-3">
            <span class="text-xs font-semibold tracking-wide uppercase opacity-60">
              {readNextLabel}
            </span>
            <a
              href={getPath(readNext.id, readNext.filePath)}
              class="mt-1 block font-medium text-accent hover:underline"
            >
              {readNext.data.title}
            </a>
          </div>
        </template>
      )
    }

    <!-- Mid-article opt-in: inserted before the middle H2 by script below -->
{
      !hideMidOptin && (
    <template id="mid-optin-template">
      <div class="mid-optin not-prose my-8 rounded-xl border border-accent/30 bg-accent/5 px-5 py-6 text-center">
        <h3 class="text-lg font-bold text-accent mb-1">{optin.icon} {optin.heading}</h3>
        <p class="text-sm opacity-75 mb-4 max-w-md mx-auto">{optin.subtext}</p>
        <form class="post-optin-form flex flex-col sm:flex-row gap-3 justify-center max-w-md mx-auto" data-list={optin.list} data-download={optin.download}>
          <input
            type="email"
            name="email"
            placeholder="your@email.com"
            required
            autocomplete="email"
            class="flex-1 min-w-0 px-4 py-2.5 rounded-lg border border-border bg-card text-foreground text-sm outline-none focus:border-accent transition-colors"
          />
          <button
            type="submit"
            class="px-5 py-2.5 rounded-lg bg-accent text-white font-semibold text-sm cursor-pointer whitespace-nowrap hover:opacity-90 transition-opacity disabled:opacity-50"
          >
            {optin.button}
          </button>
        </form>
        <p class="text-xs opacity-40 mt-3">🔒 No spam. Unsubscribe anytime.</p>
        <div class="post-optin-success hidden mt-4">
          <p class="text-base font-semibold text-accent">{optin.success}</p>
        </div>
      </div>
    </template>
      )
    }

    <hr class="my-8 border-dashed" />

    <EditPost class="sm:hidden" {hideEditPost} {post} />

    <ul class="mt-4 mb-8 flex flex-wrap gap-4 sm:my-8">
      {tags.map(tag => <Tag tag={slugifyStr(tag)} tagName={tag} size="sm" />)}
    </ul>

    {
      videoSchemas.map(v => (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(v)} />
      ))
    }

    <BackToTopButton />

    <ShareLinks />

    <AuthorBio />

    <hr class="my-6 border-dashed" />

    <!-- Previous/Next Post Buttons -->
    <div data-pagefind-ignore class="grid grid-cols-1 gap-6 sm:grid-cols-2">
      {
        prevPost && (
          <a
            href={getPath(prevPost.id, prevPost.filePath)}
            class="flex w-full gap-1 hover:opacity-75"
          >
            <IconChevronLeft class="inline-block flex-none rtl:rotate-180" />
            <div>
              <span>Previous Post</span>
              <div class="text-sm text-accent/85">{prevPost.title}</div>
            </div>
          </a>
        )
      }
      {
        nextPost && (
          <a
            href={getPath(nextPost.id, nextPost.filePath)}
            class="flex w-full justify-end gap-1 text-end hover:opacity-75 sm:col-start-2"
          >
            <div>
              <span>Next Post</span>
              <div class="text-sm text-accent/85">{nextPost.title}</div>
            </div>
            <IconChevronRight class="inline-block flex-none rtl:rotate-180" />
          </a>
        )
      }
    </div>
    <!-- Related posts: automatic internal links -->
    {
      relatedPosts.length > 0 && (
        <section data-pagefind-ignore class="mt-12">
          <h2 class="text-2xl font-semibold tracking-wide">Keep Learning</h2>
          <ul>
            {relatedPosts.map(p => (
              <Card variant="h3" {...p} />
            ))}
          </ul>
        </section>
      )
    }

  </main>
  <Footer />
</Layout>

<script is:inline data-astro-rerun>
  /** Create a progress indicator
   *  at the top */
  function createProgressBar() {
    // Create the main container div
    const progressContainer = document.createElement("div");
    progressContainer.className =
      "progress-container fixed top-0 z-10 h-1 w-full bg-background";

    // Create the progress bar div
    const progressBar = document.createElement("div");
    progressBar.className = "progress-bar h-1 w-0 bg-accent";
    progressBar.id = "myBar";

    // Append the progress bar to the progress container
    progressContainer.appendChild(progressBar);

    // Append the progress container to the document body or any other desired parent element
    document.body.appendChild(progressContainer);
  }
  createProgressBar();

  /** Update the progress bar
   *  when user scrolls */
  function updateScrollProgress() {
    document.addEventListener("scroll", () => {
      const winScroll =
        document.body.scrollTop || document.documentElement.scrollTop;
      const height =
        document.documentElement.scrollHeight -
        document.documentElement.clientHeight;
      const scrolled = (winScroll / height) * 100;
      if (document) {
        const myBar = document.getElementById("myBar");
        if (myBar) {
          myBar.style.width = scrolled + "%";
        }
      }
    });
  }
  updateScrollProgress();

  /** Attaches links to headings in the document,
   *  allowing sharing of sections easily */
  function addHeadingLinks() {
    const headings = Array.from(
      document.querySelectorAll("h2, h3, h4, h5, h6")
    );
    for (const heading of headings) {
      heading.classList.add("group");
      const link = document.createElement("a");
      link.className =
        "heading-link ms-2 no-underline opacity-75 md:opacity-0 md:group-hover:opacity-100 md:focus:opacity-100";
      link.href = "#" + heading.id;

      const span = document.createElement("span");
      span.ariaHidden = "true";
      span.innerText = "#";
      link.appendChild(span);
      heading.appendChild(link);
    }
  }
  addHeadingLinks();

  /** Attaches copy buttons to code blocks in the document,
   * allowing users to copy code easily. */
  function attachCopyButtons() {
    const copyButtonLabel = "Copy";
    const codeBlocks = Array.from(document.querySelectorAll("pre"));

    for (const codeBlock of codeBlocks) {
      const wrapper = document.createElement("div");
      wrapper.style.position = "relative";

      // Check if --file-name-offset custom property exists
      const computedStyle = getComputedStyle(codeBlock);
      const hasFileNameOffset =
        computedStyle.getPropertyValue("--file-name-offset").trim() !== "";

      // Determine the top positioning class
      const topClass = hasFileNameOffset
        ? "top-(--file-name-offset)"
        : "-top-3";

      const copyButton = document.createElement("button");
      copyButton.className = `copy-code absolute end-3 ${topClass} rounded bg-muted border border-muted px-2 py-1 text-xs leading-4 text-foreground font-medium`;
      copyButton.innerHTML = copyButtonLabel;
      codeBlock.setAttribute("tabindex", "0");
      codeBlock.appendChild(copyButton);

      // wrap codebock with relative parent element
      codeBlock?.parentNode?.insertBefore(wrapper, codeBlock);
      wrapper.appendChild(codeBlock);

      copyButton.addEventListener("click", async () => {
        await copyCode(codeBlock, copyButton);
      });
    }

    async function copyCode(block, button) {
      const code = block.querySelector("code");
      const text = code?.innerText;

      await navigator.clipboard.writeText(text ?? "");

      // visual feedback that task is completed
      button.innerText = "Copied";

      setTimeout(() => {
        button.innerText = copyButtonLabel;
      }, 700);
    }
  }
  attachCopyButtons();

  /* Go to page start after page swap */
  document.addEventListener("astro:after-swap", () =>
    window.scrollTo({ left: 0, top: 0, behavior: "instant" })
  );

  /* ===== Email Opt-in Forms (bottom + mid-article) ===== */
  (function () {
    var TRIPWIRE_URL = "https://start.cppbetterexplained.com/tw-sales-page";

    function bindOptinForm(form) {
      if (!form || form.dataset.bound) return;
      form.dataset.bound = "1";

      var submit  = form.querySelector("button[type=submit]");
      var success = form.parentElement.querySelector(".post-optin-success");

      form.addEventListener("submit", function (e) {
        e.preventDefault();
        var email = form.querySelector("input[name=email]").value.trim();
        submit.disabled = true;
        submit.textContent = "Sending\u2026";

        fetch("/api/subscribe", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email: email, list: form.dataset.list || "checklist" }),
          keepalive: true
        })
        .then(function (res) {
          if (!res.ok) {
            console.error("Subscribe error:", res.status);
            submit.disabled = false;
            submit.textContent = "Try again";
            return;
          }
          // Don't show the welcome mat to someone who just subscribed
          try { localStorage.setItem("wm_dismissed", String(Date.now())); } catch (err) {}
          form.style.display = "none";
          if (success) success.classList.remove("hidden");
          // Project posts: start the source-code zip download immediately
          if (form.dataset.download) {
            var a = document.createElement("a");
            a.href = form.dataset.download;
            a.setAttribute("download", "");
            document.body.appendChild(a);
            a.click();
            a.remove();
          }
          setTimeout(function () {
            window.location.href = TRIPWIRE_URL;
          }, form.dataset.download ? 2000 : 1200);
        })
        .catch(function (err) {
          console.error("Subscribe network error:", err);
          submit.disabled = false;
          submit.textContent = "Try again";
        });
      });
    }

    function insertMidOptin() {
      var article  = document.getElementById("article");
      var template = document.getElementById("mid-optin-template");
      if (!article || !template) return;
      if (article.querySelector(".mid-optin")) return;

      // Only insert in longer posts; place before the middle H2 (a natural pause)
      var headings = article.querySelectorAll("h2");
      if (headings.length < 3) return;
      var target = headings[Math.floor(headings.length / 2)];
      var box = template.content.firstElementChild.cloneNode(true);
      target.parentNode.insertBefore(box, target);
    }

    // Insert the "read next" prompt high in the article (before the first H2)
    // so the next-click suggestion is visible without scrolling to the footer.
    function insertReadNext() {
      var article = document.getElementById("article");
      var template = document.getElementById("read-next-template");
      if (!article || !template) return;
      if (article.querySelector(".read-next")) return;

      var headings = article.querySelectorAll("h2");
      if (headings.length < 2) return;
      var target = headings[0];
      var box = template.content.firstElementChild.cloneNode(true);
      target.parentNode.insertBefore(box, target);
    }

    function initOptins() {
      insertMidOptin();
      insertReadNext();
      document.querySelectorAll(".post-optin-form").forEach(bindOptinForm);
    }

    initOptins();
    document.addEventListener("astro:page-load", initOptins);
  })();
</script>
