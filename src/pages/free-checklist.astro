---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
---

<Layout title="Free C++ Checklist | C++ Better Explained" description="Download the free 1-page checklist: The 10 Mistakes Every C++ Beginner Makes (And How to Avoid Them).">
  <Header />
  <main id="main-content" class="app-layout py-16 text-center">
    <div class="mx-auto max-w-lg">
      <div class="text-5xl mb-4">📋</div>
      <h1 class="text-3xl font-bold mb-4 text-accent leading-tight">
        Download Free: The 10 Mistakes Every C++ Beginner Makes (And How to Avoid Them)
      </h1>
      <p class="text-base opacity-80 mb-8 leading-relaxed">
        A free 1-page checklist that shows you the exact traps that slow down every C++ beginner — so you can avoid them from day one.
      </p>
      <form id="cl-form" class="flex flex-col sm:flex-row gap-3 justify-center">
        <input
          type="email"
          id="cl-email"
          name="email"
          placeholder="you@example.com"
          required
          autocomplete="email"
          class="flex-1 min-w-0 px-4 py-3 rounded-lg border border-border bg-card text-foreground text-base outline-none focus:border-accent transition-colors"
        />
        <button
          type="submit"
          id="cl-submit"
          class="px-6 py-3 rounded-lg bg-accent text-white font-semibold text-base cursor-pointer whitespace-nowrap hover:opacity-90 transition-opacity disabled:opacity-50"
        >
          Send it to me
        </button>
      </form>
      <p class="text-xs opacity-50 mt-3">🔒 No spam. Unsubscribe anytime.</p>
      <div id="cl-success" class="hidden mt-6">
        <div class="text-4xl mb-3">🎉</div>
        <p class="text-lg font-semibold">You're in! Redirecting you to a special offer...</p>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<script is:inline>
(function () {
