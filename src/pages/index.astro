<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>

<script is:inline>
  (function () {
    const TRIPWIRE_URL = "https://start.cppbetterexplained.com/tw-sales-page";

    function bindOne(form) {
      if (form.dataset.bound) return;
      form.dataset.bound = "1";

      const card = form.parentElement;
      const button = form.querySelector("button");
      const done = card ? card.querySelector(".optin-done") : null;

      form.addEventListener("submit", function (e) {
        e.preventDefault();
        const input = form.querySelector("input[name=email]");
        const email = input ? input.value.trim() : "";
        if (!email) return;

        button.disabled = true;
        button.textContent = "Sending...";

        if (typeof window.gtag === "function") {
          window.gtag("event", "optin_submit", { location: "homepage" });
        }

        fetch("/api/subscribe", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email: email, list: "checklist" }),
          keepalive: true,
        })
          .then(function (res) {
            if (!res.ok) {
              button.disabled = false;
              button.textContent = "Try again";
              return;
            }
            try {
              localStorage.setItem("wm_dismissed", String(Date.now()));
            } catch {
              /* storage unavailable */
            }
            form.style.display = "none";
            if (done) done.style.display = "block";
            setTimeout(function () {
              window.location.href = TRIPWIRE_URL;
            }, 1200);
          })
          .catch(function () {
            button.disabled = false;
            button.textContent = "Try again";
          });
      });
    }

    function initOptins() {
      const forms = document.querySelectorAll("form.js-optin");
      for (let i = 0; i < forms.length; i++) bindOne(forms[i]);
    }

    initOptins();
    document.addEventListener("astro:page-load", initOptins);
  })();
</script>
