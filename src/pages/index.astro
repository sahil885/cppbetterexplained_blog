---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";
const posts = await getCollection("blog");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);

// Categorise posts for keyword-rich sections
const beginnerSlugs = [
  "how-to-start-learning-cpp",
  "what-is-cpp-used-for",
  "cpp-roadmap",
  "cpp-hello-world-explained",
  "cpp-variables-data-types",
  "cpp-functions-tutorial",
  "cpp-arrays-tutorial",
  "cpp-classes-and-objects",
  "cpp-loops-tutorial",
  "cpp-conditionals-tutorial",
];
const projectSlugs = [
  "blackjack-cpp-using-classes",
  "traffic-light-project",
  "lottery-program-cpp",
  "merge-sort-algorithm-cpp",
];
const beginnerPosts = sortedPosts.filter(p =>
  beginnerSlugs.some(s => p.id.includes(s))
);
const projectPosts = sortedPosts.filter(p =>
  projectSlugs.some(s => p.id.includes(s))
);
---
<Layout title="Learn C++ for Beginners — Tutorials, Projects & Source Code | C++ Better Explained">
  <Header />
  <main id="main-content" data-layout="index" class="app-layout">
    <h1 class="sr-only">C++ Tutorials, Projects and Source Code Explained Step by Step</h1>

    <!-- Hero: funnel into roadmap + book -->
    <section class="pt-12 pb-6 border-b border-border">
      <h2 class="text-3xl sm:text-4xl font-bold leading-tight">Learn C++ the Easy Way</h2>
      <p class="mt-3 max-w-2xl text-foreground/70">Step-by-step tutorials, real projects, and plain-English explanations — no 1,300-page textbook required. New here? Start with the free roadmap.</p>
      <div class="mt-5 flex flex-wrap gap-3">
        <a href="/learn-cpp/" class="inline-block rounded-md bg-accent px-5 py-2.5 font-semibold text-background hover:opacity-90">Start the Free C++ Roadmap</a>
        <a href="https://start.cppbetterexplained.com/tw-sales-page" class="inline-block rounded-md border border-accent/40 px-5 py-2.5 font-semibold text-accent hover:bg-accent/10">Get the Ebook — $19</a>
      </div>

      <!-- Hero email capture -->
      <div class="mt-8 max-w-xl rounded-xl border border-accent/25 bg-accent/5 px-5 py-5">
        <p class="font-semibold">📋 Free: The 10 Mistakes Every C++ Beginner Makes</p>
        <p class="mt-1 text-sm text-foreground/70">A 1-page checklist of the traps that slow down every beginner — avoid them from day one.</p>
        <form id="hero-optin-form" class="mt-3 flex flex-col sm:flex-row gap-3">
          <input
            type="email"
            name="email"
            required
            autocomplete="email"
            placeholder="your@email.com"
            class="flex-1 min-w-0 px-4 py-2.5 rounded-lg border border-border bg-card text-foreground text-sm outline-none focus:border-accent transition-colors"
          />
          <button
            type="submit"
            id="hero-optin-submit"
            class="px-5 py-2.5 rounded-lg bg-accent text-white font-semibold text-sm cursor-pointer whitespace-nowrap hover:opacity-90 transition-opacity disabled:opacity-50"
          >
            Send it to me →
          </button>
        </form>
        <p class="mt-2 text-xs text-foreground/50">🔒 No spam. Unsubscribe anytime.</p>
        <div id="hero-optin-success" class="hidden mt-3">
          <p class="text-base font-semibold text-accent">🎉 Check your inbox — it's on its way!</p>
        </div>
      </div>
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-b border-border": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">Featured</h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      beginnerPosts.length > 0 && (
        <section id="beginner-tutorials" class="pt-12 pb-6 border-b border-border">
          <h2 class="text-2xl font-semibold tracking-wide">C++ Beginner Tutorials</h2>
          <p class="mt-2 mb-4 text-sm text-foreground/70">Start here if you're new to C++. These guides cover the fundamentals step by step.</p>
          <ul>
            {beginnerPosts.slice(0, SITE.postPerIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
          <div class="mt-4">
            <LinkButton href="/posts/">
              All Tutorials
              <IconArrowRight class="inline-block rtl:-rotate-180" />
            </LinkButton>
          </div>
        </section>
      )
    }

    {
      projectPosts.length > 0 && (
        <section id="cpp-projects" class="pt-12 pb-6 border-b border-border">
          <h2 class="text-2xl font-semibold tracking-wide">C++ Project Guides</h2>
          <p class="mt-2 mb-4 text-sm text-foreground/70">Learn by building. Fully annotated C++ projects you can read, run, and modify.</p>
          <ul>
            {projectPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">Advanced C++ Topics</h2>
          <ul>
            {recentPosts
              .filter(p => !beginnerSlugs.some(s => p.id.includes(s)) && !projectSlugs.some(s => p.id.includes(s)))
              .slice(0, SITE.postPerIndex)
              .map(data => (
                <Card variant="h3" {...data} />
              ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href="/posts/">
        All Posts
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>
<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>

<script is:inline>
(function () {
  var TRIPWIRE_URL = "https://start.cppbetterexplained.com/tw-sales-page";

  function initHeroOptin() {
    var form = document.getElementById("hero-optin-form");
    if (!form || form.dataset.bound) return;
    form.dataset.bound = "1";

    var submit  = document.getElementById("hero-optin-submit");
    var success = document.getElementById("hero-optin-success");

    form.addEventListener("submit", function (e) {
      e.preventDefault();
      var email = form.querySelector("input[name=email]").value.trim();
      submit.disabled = true;
      submit.textContent = "Sending\u2026";

      fetch("/api/subscribe", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email: email, list: "checklist" }),
        keepalive: true
      })
      .then(function (res) {
        if (!res.ok) {
          console.error("Subscribe error:", res.status);
          submit.disabled = false;
          submit.textContent = "Try again";
          return;
        }
        try { localStorage.setItem("wm_dismissed", String(Date.now())); } catch (err) {}
        form.style.display = "none";
        if (success) success.classList.remove("hidden");
        setTimeout(function () {
          window.location.href = TRIPWIRE_URL;
        }, 1200);
      })
      .catch(function (err) {
        console.error("Subscribe network error:", err);
        submit.disabled = false;
        submit.textContent = "Try again";
      });
    });
  }

  initHeroOptin();
  document.addEventListener("astro:page-load", initHeroOptin);
})();
</script>
